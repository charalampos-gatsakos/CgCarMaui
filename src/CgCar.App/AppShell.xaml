<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CgCar.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CgCar.App.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="CgCar">

    <!-- Root page. The list and edit pages are pushed on top of it via routes registered in AppShell.xaml.cs. -->
    <ShellContent
        Title="CgCar"
        ContentTemplate="{DataTemplate views:DashboardPage}"
        Route="dashboard" />

</Shell>
